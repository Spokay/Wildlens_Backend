body:json {
  {
    "name": "Lapin",
    "latin_name": "Oryctolagus cuniculus",
    "description": "Le lapin de garenne, appelé également le lapin sauvage, le lapin européen ou le lapin des bois, est un petit mammifère herbivore appartenant à l’ordre des lagomorphes et à la famille des léporidés.",
    "size": "34 à 50cm",
    "region": "Europe, Afrique",
    "fun_fact": "Le lapin de garenne vit dans des milieux où les sols sont meubles et bien drainés pour y construire son terrier : les prairies, les forêts, les bosquets, les lisières de forêts, les landes, les garrigues, les bocages.",
    "specie_exemple_photo_url": "https://www.google.com/url?sa=i&url=https%3A%2F%2Fwww.maganimo.com%2Flapins%3Fdoc%3Dlapin-garenne-faut-savoir&psig=AOvVaw2aNUYyoBu4oXNG17eBGK4D&ust=1747561821728000&source=images&cd=vfe&opi=89978449&ved=0CBQQjRxqFwoTCLj6v6Kdqo0DFQAAAAAdAAAAABAL",
    "footprint_exemple_photo_url": "https://www.google.com/url?sa=i&url=https%3A%2F%2Fwww.lanatureenmouvement.com%2Fmedia%2F1c2128e3-e12d-49e0-9cf3-e5b82927a11a-empreintes-de-lapin-de-garenne-et-de-lievre-d-europe&psig=AOvVaw00g0RiV4p3cnJ2v30pRx-D&ust=1747561806874000&source=images&cd=vfe&opi=89978449&ved=0CBQQjRxqFwoTCODzzZidqo0DFQAAAAAdAAAAABAE",
    "family_id": 1,
    "habitats_ids": [1, 4]
  }
  
}

